use nide:
  include command-id-of defcommand editor-insert get-active-editor-input-driver
    run-command set-active-editor-driver

; Keybindings name the command they invoke, so the palette can look up which
; keys reach a given command. A binding may also carry a callable directly, for
; panel-local behaviour that is not worth registering as a command; those have
; no id and so show no key hint.

defcommand noop:
  "Do nothing."
  nothing

record KeyBinding:
  key = ""
  ctrl = false
  alt = false
  shift = false
  gui = false
  commandID = ""
  command = (value-of noop)
  children = ([])

record EditorInputDriver:
  name = ""
  mode = ""
  bindings = ([])
  textCommand = ""

fun binding-children body:
  if (= (length (statements body)) 0):
    ([])
  else:
    list-from (statements body)

block-command key keyName command:
  KeyBinding:
    key = (eval keyName)
    commandID = (command-id-of (eval command))
    command = (eval command)
    children = (binding-children block)

block-command ctrl keyName command:
  KeyBinding:
    key = (eval keyName)
    ctrl = true
    commandID = (command-id-of (eval command))
    command = (eval command)
    children = (binding-children block)

block-command alt keyName command:
  KeyBinding:
    key = (eval keyName)
    alt = true
    commandID = (command-id-of (eval command))
    command = (eval command)
    children = (binding-children block)

block-command shift keyName command:
  KeyBinding:
    key = (eval keyName)
    shift = true
    commandID = (command-id-of (eval command))
    command = (eval command)
    children = (binding-children block)

block-command key-combo keyName ctrlPressed altPressed shiftPressed guiPressed command:
  KeyBinding:
    key = (eval keyName)
    ctrl = (eval ctrlPressed)
    alt = (eval altPressed)
    shift = (eval shiftPressed)
    gui = (eval guiPressed)
    commandID = (command-id-of (eval command))
    command = (eval command)
    children = (binding-children block)

block-command keymap:
  list-from (statements block)

state "nide-keymap-dispatch":
  pendingKeymap = ([])
  pendingKeymapOwner = ""

defcommand cancel-key-sequence:
  "Abandon a partially typed key sequence."
  set pendingKeymap ([])
  set pendingKeymapOwner ""

defcommand editor-insert-frame-text:
  "Insert the text typed this frame into the active editor."
  define:
    input = textInput
  if (= input ""):
    nothing
  else:
    editor-insert input

; --- dispatch ---------------------------------------------------------------

fun active-keymap owner bindings:
  if (empty? pendingKeymap):
    bindings
  else:
    if (= pendingKeymapOwner owner):
      pendingKeymap
    else:
      ([])

fun key-binding-pressed binding:
  keyComboPressed binding.key binding.ctrl binding.alt binding.shift binding.gui

fun run-binding binding:
  if (= binding.commandID ""):
    call binding.command
  else:
    run-command binding.commandID

fun run-keybindings-in owner bindings:
  if (empty? bindings):
    false
  else:
    define:
      binding = (first bindings)
    if (key-binding-pressed binding):
      do:
        if (empty? binding.children):
          do:
            cancel-key-sequence
            run-binding binding
        else:
          set pendingKeymap binding.children
          set pendingKeymapOwner owner
        true
    else:
      run-keybindings-in owner (rest bindings)

fun run-keybindings bindings:
  run-keybindings-owned "default" bindings

fun run-keybindings-owned owner bindings:
  run-keybindings-in owner (active-keymap owner bindings)

fun run-driver-text-command driver:
  if (= driver.textCommand ""):
    nothing
  else:
    run-command driver.textCommand

fun run-editor-input-driver driver:
  when (not (= (get-active-editor-input-driver) "owl")):
    set-active-editor-driver "owl"
  if (not (run-keybindings-owned "editor" driver.bindings)):
    run-driver-text-command driver
  else:
    nothing
