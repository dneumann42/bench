import "core.owl"

use nide:
  include get-active-editor-cursor-style set-editor-block-cursor
    set-editor-line-cursor

state "nide-vi-editor-input":
  viMode = "normal"

defcommand vi-insert-mode:
  "Enter vi insert mode."
  set viMode "insert"
  set-editor-line-cursor

defcommand vi-normal-mode:
  "Enter vi normal mode."
  set viMode "normal"
  set-editor-block-cursor

defcommand vi-append-mode:
  "Enter vi insert mode one character to the right."
  run-command "editor-forward-char"
  vi-insert-mode

defcommand vi-open-line-below:
  "Open a new line below the cursor and enter insert mode."
  run-command "editor-line-end"
  run-command "editor-newline"
  vi-insert-mode

defcommand vi-open-line-above:
  "Open a new line above the cursor and enter insert mode."
  run-command "editor-line-start"
  run-command "editor-newline"
  run-command "editor-previous-line"
  vi-insert-mode

defcommand vi-delete-char:
  "Delete the character under the cursor."
  run-command "editor-delete-forward"

defcommand vi-insert-text:
  "Insert this frame's typed text, but only in vi insert mode."
  if (= viMode "insert"):
    run-command "editor-insert-frame-text"
  else:
    nothing

fun vi-bindings:
  if (= viMode "insert"):
    keymap:
      key "escape" "vi-normal-mode"
      key "left" "editor-backward-char"
      key "right" "editor-forward-char"
      key "up" "editor-previous-line"
      key "down" "editor-next-line"
      key "backspace" "editor-delete-backward"
      key "delete" "editor-delete-forward"
      key "enter" "editor-newline"
  else:
    keymap:
      key "escape" "vi-normal-mode"
      key "left" "editor-backward-char"
      key "right" "editor-forward-char"
      key "up" "editor-previous-line"
      key "down" "editor-next-line"
      key "h" "editor-backward-char"
      key "l" "editor-forward-char"
      key "k" "editor-previous-line"
      key "j" "editor-next-line"
      key "0" "editor-line-start"
      key "home" "editor-line-start"
      key "end" "editor-line-end"
      key "w" "editor-forward-word"
      key "b" "editor-backward-word"
      shift "semicolon" "command-palette"
      key "i" "vi-insert-mode"
      key "a" "vi-append-mode"
      key "o" "vi-open-line-below"
      shift "o" "vi-open-line-above"
      key "x" "vi-delete-char"
      key "backspace" "editor-delete-backward"
      key "delete" "editor-delete-forward"
      ctrl "u" "editor-kill-line-start"
      ctrl "r" "editor-redo"

; Kept apart from the driver record so the record stays a pure value that can
; be cached; this still runs on every key event.
fun vi-sync-cursor:
  when (= viMode "normal"):
    when (not (= (get-active-editor-cursor-style) "block")):
      set-editor-block-cursor
  when (= viMode "insert"):
    when (not (= (get-active-editor-cursor-style) "line")):
      set-editor-line-cursor

fun vi-editor-driver:
  EditorInputDriver:
    name = "vi"
    mode = viMode
    textCommand = "vi-insert-text"
    bindings = (vi-bindings)
