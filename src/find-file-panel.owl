import "finder-panel.owl"

use nide:
  include close-floating file-preview-text get-active-project-path get-floating-activation-generation get-home-directory keyPressed open-file-path project-files-window string

state "find-file-panel":
  queryID = (id "find-file" "query")
  previewID = (id "find-file" "preview")
  resultsID = (id "find-file" "results")
  selectedPath = ""
  lastActivation = -1
  pendingFocus = false
  ignoredDirectories = []:
    ".git"
    "node_modules"
    ".nimcache"
    ".cache"
    ".direnv"
    ".next"
    ".svelte-kit"
    "dist"
    "build"
    "target"
    "coverage"

fun find-file-root:
  define:
    projectPath = (get-active-project-path)
  if (= projectPath ""):
    get-home-directory
  else:
    projectPath

fun preview-syntax:
  finder-preview-syntax "find-preview"

fun file-row item:
  define:
    rowID = (id "find-file" "row" item.path)
  button rowID (string item.relative):
    width = fill
    height = fixed 26
    fontName = "editor"
    buttonPadding = (insets 6 2 6 2)
    buttonBorderStyle = ButtonBorderNone
    buttonChromeStyle = ButtonChromeFlat
    buttonTextAlign = Start
    background = (pick item.selected (color 43 83 106) (color 0 0 0 0))
    textScroll = true
  tooltip rowID item.path

fun find-file-select-path path:
  when (not (= path "")):
    set selectedPath path
    finder-scroll-row "find-file" resultsID path

fun find-file-current-path rows:
  finder-current-key rows selectedPath "path"

fun find-file-current-rows:
  project-files-window (find-file-root) (editorText queryID) selectedPath ignoredDirectories

fun find-file-previous:
  define:
    rows = (find-file-current-rows)
    currentPath = (find-file-current-path rows)
  find-file-select-path (finder-previous-key rows currentPath "path")

fun find-file-next:
  define:
    rows = (find-file-current-rows)
    currentPath = (find-file-current-path rows)
  find-file-select-path (finder-next-key rows currentPath "path")

fun find-file-reset:
  set selectedPath ""
  setEditorText queryID ""
  setEditorText previewID ""

widget find-file-panel:
  define:
    activation = (get-floating-activation-generation)
    rootPath = (find-file-root)
    query = (editorText queryID)
    rows = (project-files-window rootPath query selectedPath ignoredDirectories)
    currentPath = (find-file-current-path rows)
    previewText = (file-preview-text currentPath)

  events:
    when (not (= lastActivation activation)):
      find-file-reset
      set lastActivation activation
      set pendingFocus true
    when pendingFocus:
      when (not (keyboardInput?)):
        finder-focus-query queryID
        set pendingFocus false
    setEditorText previewID previewText
    setEditorSyntax previewID (preview-syntax)
    finder-list-keybindings "find-file-list" (value-of find-file-previous) (value-of find-file-next)
    when (and (keyPressed "enter") (not (= currentPath ""))):
      open-file-path currentPath
      find-file-reset
      close-floating
    for item (iter rows):
      when (clicked (id "find-file" "row" item.path)):
        find-file-select-path item.path

  finder-panel "find-file" queryID:
    finder-results resultsID rows "No files" (fixed 340):
      for item (iter rows):
        file-row item
    finder-preview previewID "find-preview"
