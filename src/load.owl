use nide/toolbar:
  include set-toolbars toolbar-value menu-value item-value tool-value widget-value spacer-value statusbar

use nide/panels:
  include set-panels panel-value

use nide:
  include get-current-mode get-status

import "editor-input.owl"

block-command toolbars:
  set-toolbars (list-from (statements block))

block-command toolbar id dock:
  toolbar-value (eval id) (eval dock) (list-from (statements block))

block-command panels:
  set-panels (list-from (statements block))

fun dock-panel id title dock source widget open size:
  panel-value id title dock source widget open size

block-command toolbar-menu id label:
  menu-value (eval id) (eval label) (list-from (statements block))

fun toolbar-item id label command:
  item-value id label command

fun toolbar-tool id label command:
  tool-value id label command

fun toolbar-widget id source widget:
  widget-value id source widget

fun toolbar-spacer:
  spacer-value

fun keybinding-mode-labels:
  []:
    "VS Code"
    "Emacs"
    "Vi"

fun keybinding-mode-values:
  []:
    "vscode"
    "emacs"
    "vi"

fun keybinding-mode-index:
  cond:
    when (= editorInputDriver "vscode"):
      0
    when (= editorInputDriver "vi"):
      2
    when true:
      1

fun keybinding-mode-control:
  define:
    picked = nothing
    values = (keybinding-mode-values)
  events:
    set picked (combobox (id "statusbar" "keybindings") (keybinding-mode-index) (keybinding-mode-labels))
    when (not (= picked nothing)):
      set editorInputDriver (nth values picked)
      if (= editorInputDriver "vi"):
        vi-normal-mode
      else:
        set-editor-line-cursor
  combobox (id "statusbar" "keybindings") (keybinding-mode-index) (keybinding-mode-labels):
    width = fixed 112
    height = fit

fun dialog-list-keybindings previousCommand nextCommand:
  keymap:
    key "up" previousCommand
    ctrl "p" previousCommand
    key "down" nextCommand
    ctrl "n" nextCommand

fun file-menu:
  toolbar-menu "file" "File":
    toolbar-item "file.newFile" "New File" "file-new"
    toolbar-item "file.openFile" "Find File" "find-file"
    toolbar-item "file.openSystemFile" "Open File Dialog" "file-open"
    toolbar-item "file.openBuffer" "Find Buffer" "find-buffer"
    toolbar-item "file.saveBuffer" "Save Buffer" "file-save"
    toolbar-item "file.saveBufferAs" "Save Buffer As" "file-save-as"

fun project-menu:
  toolbar-menu "project" "Project":
    toolbar-item "project.open" "Open Project" "project-open"
    toolbar-item "project.run" "Run" "project-run"
    toolbar-item "project.build" "Build" "project-build"
    toolbar-item "project.settings" "Project Settings" "project-settings"

toolbars:
  toolbar "main" "top":
    file-menu
    project-menu
    toolbar-spacer
    toolbar-widget "project-toolbar" "project-toolbar.owl" "project-toolbar"

  toolbar "pane-tools" "left":
    toolbar-tool "toggleProjectsPanel" "" "toggle-projects-panel"
    toolbar-tool "toggleFileExplorerPanel" "" "toggle-file-explorer-panel"
    toolbar-spacer
    toolbar-tool "splitColumn" "" "pane-split-column"
    toolbar-tool "splitRow" "" "pane-split-row"
    toolbar-tool "unsplit" "" "pane-unsplit"

panels:
  dock-panel "projects" "Projects" "left" "projects-panel.owl" "projects-panel" false 280
  dock-panel "files" "Files" "left" "file-explorer-panel.owl" "file-explorer-panel" false 320
  dock-panel "find-file" "Find File" "floating" "find-file-panel.owl" "find-file-panel" false 720
  dock-panel "find-buffer" "Find Buffer" "floating" "find-buffer-panel.owl" "find-buffer-panel" false 720

statusbar:
  label (id "statusbar" "status") (get-status):
    width = fill
    height = fit

  spacer (id "statusbar" "spacer"):
    width = fill
    height = fixed 1

  label (id "statusbar" "mode") (get-current-mode):
    width = fit
    height = fit

  keybinding-mode-control

  button (id "statusbar" "git") "Git":
    set-status "Git is not implemented"
