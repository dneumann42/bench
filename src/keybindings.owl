import "editor-input.owl"

use nide:
  include close-floating open-floating-panel toggle-floating

fun nide-find-file:
  open-floating-panel "find-file"

fun nide-find-buffer:
  open-floating-panel "find-buffer"

fun nide-toggle-floating:
  toggle-floating

fun nide-close-floating:
  close-floating

fun nide-global-keybindings:
  keymap:
    ctrl "x" noop:
      key "f" nide-find-file
      key "b" nide-find-buffer
      key "x" nide-toggle-floating
      ctrl "g" cancel-key-sequence

widget nide-keybindings:
  events:
    when (keyboardInput?):
      if (not (run-keybindings-owned "nide-global" (nide-global-keybindings))):
        run-configured-editor-input-driver
