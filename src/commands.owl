use nide:
  include add-project auto-track-opened-projects buffer-open command-palette
    directory-files dir-exists? file-exists? file-new file-open file-save
    file-save-as find-buffer find-file get-projects open-build-launch-tab
    open-check-launch-tab open-project open-run-launch-tab pane-split-column
    pane-split-row pane-unsplit path-base-name path-join path-normalize
    path-parent path-stem project-build project-open project-run
    project-settings save-projects set-nide-status set-process-launch-tab
    set-status string text-contains toggle-file-explorer-panel
    toggle-projects-panel version

fun nide-get key:
  dict-get nide-state key

fun set-build-launch-tab open:
  set-process-launch-tab "build" open

fun set-run-launch-tab open:
  set-process-launch-tab "run" open

fun set-check-launch-tab open:
  set-process-launch-tab "check" open

fun get-buffers:
  nide-get "buffers"

fun get-active-buffer-path:
  nide-get "active-buffer-path"

fun get-active-buffer-text:
  nide-get "active-buffer-text"

fun project-for-path projects path:
  define:
    normalizedPath = (path-normalize path)
  cond:
    when (empty? projects):
      nothing
    when (= (path-normalize (first projects).directoryPath) normalizedPath):
      first projects
    when true:
      project-for-path (rest projects) normalizedPath

fun nimble-file-in files:
  cond:
    when (empty? files):
      ""
    when (text-contains (path-base-name (first files)) ".nimble" true):
      first files
    when true:
      nimble-file-in (rest files)

fun find-nimble-project-dir path:
  define:
    normalizedPath = (path-normalize path)
    nimbleFile = (nimble-file-in (directory-files normalizedPath))
    parent = (path-parent normalizedPath)
  cond:
    when (not (dir-exists? normalizedPath)):
      ""
    when (not (= nimbleFile "")):
      normalizedPath
    when (or (= parent normalizedPath) (= parent "")):
      ""
    when true:
      find-nimble-project-dir parent

fun nimble-project-name projectDir:
  define:
    nimbleFile = (nimble-file-in (directory-files projectDir))
  if (= nimbleFile ""):
    path-base-name projectDir
  else:
    path-stem nimbleFile

fun open-tracked-or-new-project projectDir:
  define:
    normalizedDir = (path-normalize projectDir)
    tracked = (project-for-path (get-projects) normalizedDir)
  if (= tracked nothing):
    if auto-track-opened-projects:
      define:
        projectName = (nimble-project-name normalizedDir)
      add-project projectName normalizedDir
      open-project projectName
      save-projects
      set-nide-status (string "Added project " projectName)
    else:
      set-nide-status (string "Project is not tracked: " normalizedDir)
  else:
    open-project tracked.name
    set-nide-status (string "Opened project " tracked.name)

fun project-open-path path:
  define:
    projectDir = (find-nimble-project-dir path)
  if (= projectDir ""):
    set-nide-status (string "No Nimble project found at " path)
  else:
    open-tracked-or-new-project projectDir
