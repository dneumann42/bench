import "finder-panel.owl"

use nide:
  include close-floating get-buffer-preview-text get-buffers get-floating-activation-generation keyPressed kill-buffer preview-buffer string switch-buffer text-contains

state "find-buffer-panel":
  queryID = (id "find-buffer" "query")
  previewID = (id "find-buffer" "preview")
  resultsID = (id "find-buffer" "results")
  selectedID = ""
  lastActivation = -1
  pendingFocus = false

fun buffer-matches? item query:
  or (text-contains item.name query true) (text-contains item.path query true)

fun visible-buffers buffers query:
  define:
    output = []
  for item (iter buffers):
    when (buffer-matches? item query):
      append output item
  output

fun selected-buffer rows selected:
  cond:
    when (empty? rows):
      nothing
    when (= (first rows).id selected):
      first rows
    when true:
      selected-buffer (rest rows) selected

fun buffer-preview-syntax:
  finder-preview-syntax "buffer-preview"

fun buffer-row item currentID:
  define:
    rowID = (id "find-buffer" "row" item.id)
    killID = (id "find-buffer" "kill" item.id)
  row (id "find-buffer" "row-shell" item.id):
    width = fill
    height = fixed 28
    gap = 4
    button rowID item.title:
      width = fill
      height = fixed 28
      fontName = "editor"
      buttonPadding = (insets 6 2 6 2)
      buttonBorderStyle = ButtonBorderNone
      buttonChromeStyle = ButtonChromeFlat
      buttonTextAlign = JustifyStart
      background = (pick (= item.id currentID) (color 43 83 106) (color 0 0 0 0))
      textScroll = true
    button killID "":
      width = fixed 28
      height = fixed 28
      fontName = "icon"
      buttonVariant = ButtonIcon
  tooltip rowID (pick (= item.path "") item.name item.path)
  tooltip killID "Kill buffer"

fun find-buffer-select-id bufferID:
  when (not (= bufferID "")):
    set selectedID bufferID
    preview-buffer bufferID
    finder-scroll-row "find-buffer" resultsID bufferID

fun find-buffer-current-rows:
  visible-buffers (get-buffers) (editorText queryID)

fun find-buffer-current-id rows:
  finder-current-key rows selectedID "id"

fun find-buffer-previous:
  define:
    rows = (find-buffer-current-rows)
    currentID = (find-buffer-current-id rows)
  find-buffer-select-id (finder-previous-key rows currentID "id")

fun find-buffer-next:
  define:
    rows = (find-buffer-current-rows)
    currentID = (find-buffer-current-id rows)
  find-buffer-select-id (finder-next-key rows currentID "id")

fun find-buffer-reset:
  set selectedID ""
  setEditorText queryID ""
  setEditorText previewID ""

widget find-buffer-panel:
  define:
    activation = (get-floating-activation-generation)
    query = (editorText queryID)
    rows = (visible-buffers (get-buffers) query)
    currentID = (find-buffer-current-id rows)
    current = (selected-buffer rows currentID)
    previewText = (get-buffer-preview-text)

  events:
    when (not (= lastActivation activation)):
      find-buffer-reset
      set lastActivation activation
      set pendingFocus true
    when pendingFocus:
      when (not (keyboardInput?)):
        finder-focus-query queryID
        set pendingFocus false
    setEditorText previewID previewText
    setEditorSyntax previewID (buffer-preview-syntax)
    finder-list-keybindings "find-buffer-list" (value-of find-buffer-previous) (value-of find-buffer-next)
    when (and (keyPressed "enter") (not (= currentID ""))):
      switch-buffer currentID
      find-buffer-reset
      close-floating
    for item (iter rows):
      when (clicked (id "find-buffer" "row" item.id)):
        find-buffer-select-id item.id
      when (clicked (id "find-buffer" "kill" item.id)):
        kill-buffer item.id
        when (= selectedID item.id):
          set selectedID ""

  finder-panel "find-buffer" queryID:
    finder-results resultsID rows "No buffers" (fixed 340):
      for item (iter rows):
        buffer-row item currentID
    finder-preview previewID "buffer-preview"
