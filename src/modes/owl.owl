use nide:
  include defcommand rgb set-editor-syntax set-mode-hook syntax regex word span starts-with clear-editor-syntax

define:
  owlKeywordColor = rgb 178 139 222
  owlFormColor = rgb 110 219 188
  owlStringColor = rgb 226 196 92
  owlNumberColor = rgb 225 158 104
  owlCommentColor = rgb 142 153 158
  owlOperatorColor = rgb 222 116 139
  owlConstantColor = rgb 104 184 222

defcommand owl-enable-highlighting:
  "Turn on Owl syntax highlighting in the active buffer."
  tags "mode" "owl"
  define:
    owlRules = []:
      starts-with ";" owlCommentColor
      span "\"" "\"" owlStringColor
      regex "\\b[0-9]+(\\.[0-9]+)?\\b" owlNumberColor
      regex "\\b(use|include|define|fun|block-command|record|if|cond|when|else|with|set|append|return)\\b" owlKeywordColor
      regex "\\b(true|false|nothing)\\b" owlConstantColor
      regex "\\b[A-Za-z_][A-Za-z0-9_-]*\\s*:" owlFormColor
      regex "[=+\\-*/<>!?.,|&^%@~]+" owlOperatorColor
  set-editor-syntax (syntax "owl" owlRules)

defcommand owl-disable-highlighting:
  "Turn off Owl syntax highlighting in the active buffer."
  tags "mode" "owl"
  clear-editor-syntax

set-mode-hook "onload" "owl-enable-highlighting"
set-mode-hook "onunload" "owl-disable-highlighting"
