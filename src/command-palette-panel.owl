import "finder-panel.owl"
import "keybindings.owl"

use nide:
  include close-floating command-generation command-keybinding-label
    command-palette-rows get-floating-activation-generation
    interactive-commands keyPressed list-window run-command text-column

state "command-palette-panel":
  queryID = (id "command-palette" "query")
  resultsID = (id "command-palette" "results")
  selectedID = ""
  lastActivation = -1
  pendingFocus = false

fun command-palette-item labels entry:
  {}:
    id = entry.id
    description = entry.description
    keybindings = (command-keybinding-label labels entry.id)

fun command-palette-items:
  define:
    labels = (all-command-keybindings)
    output = []
  for entry (iter (interactive-commands)):
    append output (command-palette-item labels entry)
  output

; The rows are asked for several times a frame -- to build the list, to resolve
; the selection, and again when navigating -- and only change when the query,
; the selection or the set of commands does.
state "command-palette-rows-cache":
  rowsKey = ""
  rowsCache = ([])

fun command-palette-current-rows:
  define:
    query = (editorText queryID)
    key = (string query "|" selectedID "|" (command-generation))
  when (not (= key rowsKey)):
    set rowsCache (command-palette-rows (command-palette-items) query selectedID)
    set rowsKey key
  rowsCache

fun command-palette-current-id rows:
  finder-current-key rows selectedID "id"

fun selected-command-palette-row rows selected:
  define:
    found = nothing
  for row (iter rows):
    when (= row.id selected):
      set found row
  found

; Button height plus the column gap, which is the pitch the window slices on.
fun command-palette-row-height:
  29

fun command-palette-select-id commandID:
  when (not (= commandID "")):
    set selectedID commandID
    finder-scroll-index resultsID
      (finder-index-of (command-palette-current-rows) commandID "id")
      (command-palette-row-height)

fun command-palette-previous:
  define:
    rows = (command-palette-current-rows)
    currentID = (command-palette-current-id rows)
  command-palette-select-id (finder-previous-key rows currentID "id")

fun command-palette-next:
  define:
    rows = (command-palette-current-rows)
    currentID = (command-palette-current-id rows)
  command-palette-select-id (finder-next-key rows currentID "id")

fun command-palette-reset:
  set selectedID ""
  setEditorText queryID ""

; Columns are laid out by padding to fixed character widths, which lines them
; up in the monospaced editor font. The description is truncated to fit; the
; tooltip carries the whole thing.
fun command-palette-row-text item:
  string
    (text-column item.id 34)
    " "
    (text-column item.keybindings 18)
    " "
    (text-column item.description 72 false)

fun command-palette-row-tooltip item:
  if (= item.keybindings ""):
    string item.id " -- " item.description
  else:
    string item.id " (" item.keybindings ") -- " item.description

fun command-palette-row item currentID:
  define:
    rowID = (id "command-palette" "row" item.id)
  button rowID (command-palette-row-text item):
    width = fill
    height = fixed 28
    fontName = "editor"
    buttonPadding = (insets 6 2 6 2)
    buttonBorderStyle = ButtonBorderNone
    buttonChromeStyle = ButtonChromeFlat
    buttonTextAlign = JustifyStart
    background = (pick (= item.id currentID) (color 43 83 106) (color 0 0 0 0))
    textScroll = true
  tooltip rowID (command-palette-row-tooltip item)

widget command-palette-panel:
  define:
    activation = (get-floating-activation-generation)
    allRows = (command-palette-current-rows)
    currentID = (command-palette-current-id allRows)
    current = (selected-command-palette-row allRows currentID)
    window = (list-window allRows (scrollY resultsID) (widgetHeight resultsID) (command-palette-row-height) 6)
    rows = (dict-get window "rows")

  events:
    when (not (= lastActivation activation)):
      command-palette-reset
      set lastActivation activation
      set pendingFocus true
    when pendingFocus:
      when (not (keyboardInput?)):
        finder-focus-query queryID
        set pendingFocus false
    finder-list-keybindings "command-palette-list" (value-of command-palette-previous) (value-of command-palette-next)
    when (and (keyPressed "enter") (not (= currentID "")) (not (= current nothing))):
      run-command currentID
      command-palette-reset
      close-floating
    for item (iter rows):
      when (clicked (id "command-palette" "row" item.id)):
        command-palette-select-id item.id

  finder-panel "command-palette" queryID:
    finder-results resultsID allRows "No commands" fill:
      spacer (id "command-palette" "rows-before"):
        width = fill
        height = fixed (dict-get window "before")
      for item (iter rows):
        command-palette-row item currentID
      spacer (id "command-palette" "rows-after"):
        width = fill
        height = fixed (dict-get window "after")
